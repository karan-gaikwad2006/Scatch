<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - Scatch</title>
    <meta name="description" content="Browse our latest collection of premium products on Scatch.">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html, body { height: 100vh; overflow: hidden; }
        body { font-family: 'Inter', sans-serif; }

        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #9ca3af; }

        /* Checkbox custom */
        input[type="checkbox"]:checked { accent-color: #111827; }

        /* Filter collapse animation */
        .filter-content {
            overflow: hidden;
            transition: max-height 0.3s ease;
            max-height: 200px;
        }
        .filter-content.collapsed { max-height: 0; }

        /* Product card hover lift */
        .product-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px -6px rgba(0,0,0,0.12);
        }

        /* Active category tab */
        .cat-tab.active {
            background-color: #111827;
            color: #ffffff;
        }

        /* Size chip active */
        .size-chip.active {
            background-color: #111827;
            color: #ffffff;
            border-color: #111827;
        }

        /* Add to cart button hover */
        .add-to-cart-btn {
            opacity: 0;
            transition: opacity 0.2s ease;
        }
        .product-card:hover .add-to-cart-btn {
            opacity: 1;
        }
    </style>
</head>
<body class="bg-[#f5f5f5] h-screen overflow-hidden flex flex-col">

    <!-- ============================
         NAVBAR
    ============================= -->
    <nav class="bg-white border-b border-gray-100 sticky top-0 z-40 shadow-sm">
        <div class="max-w-screen-2xl mx-auto px-4 md:px-8 flex items-center justify-between h-16">

            <!-- Left: Hamburger + Logo + Nav Links -->
            <div class="flex items-center space-x-6">
                <button id="sidebar-toggle" class="p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors lg:hidden">
                    <i data-lucide="menu" class="w-5 h-5"></i>
                </button>
                <a href="/" class="text-xl font-bold text-gray-900 tracking-tight">Scatch</a>
                <div class="hidden md:flex items-center space-x-6 text-sm font-medium text-gray-500">
                    <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
                    <a href="/shop" class="text-gray-900 font-semibold border-b-2 border-gray-900 pb-0.5">Collections</a>
                    <a href="#" class="hover:text-gray-900 transition-colors">New</a>
                </div>
            </div>

            <!-- Right: Search + Icons -->
            <div class="flex items-center space-x-2">
                <!-- Search (desktop) -->
                <div class="hidden md:flex items-center bg-gray-100 rounded-full px-4 py-2 space-x-2 w-52 xl:w-64">
                    <i data-lucide="search" class="w-4 h-4 text-gray-400 flex-shrink-0"></i>
                    <input id="navbar-search" type="text" placeholder="Search products..."
                           class="bg-transparent text-sm text-gray-700 placeholder-gray-400 outline-none w-full">
                </div>

                <!-- Mobile Search Icon -->
                <button class="md:hidden p-2 rounded-full hover:bg-gray-100 transition-colors text-gray-600">
                    <i data-lucide="search" class="w-5 h-5"></i>
                </button>

                <!-- Cart -->
                <a href="/cart" id="cart-btn"
                   class="relative p-2 rounded-full hover:bg-gray-100 transition-colors text-gray-700 flex items-center justify-center">
                    <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                    <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-gray-900 text-white text-[10px] font-bold rounded-full flex items-center justify-center">3</span>
                </a>

                <!-- Wishlist -->
                <button class="p-2 rounded-full hover:bg-gray-100 transition-colors text-gray-700">
                    <i data-lucide="heart" class="w-5 h-5"></i>
                </button>

                <!-- Profile -->
                <a href="#" class="p-2 rounded-full hover:bg-gray-100 transition-colors text-gray-700">
                    <i data-lucide="user" class="w-5 h-5"></i>
                </a>
            </div>
        </div>
    </nav>

    <!-- ============================
         MAIN LAYOUT
    ============================= -->
    <div class="w-full px-4 md:px-8 py-6 flex gap-6 flex-1 overflow-hidden">

        <!-- ========================
             SIDEBAR: FILTERS
        ========================= -->
        <aside id="filter-sidebar"
               class="hidden lg:flex flex-col w-56 xl:w-64 flex-shrink-0 bg-white rounded-2xl shadow-sm border border-gray-100 p-5 overflow-y-auto">

            <div class="flex items-center justify-between mb-5">
                <h2 class="text-sm font-bold text-gray-900 uppercase tracking-widest">Filters</h2>
                <button id="clear-filters" class="text-xs text-gray-400 hover:text-gray-700 font-medium transition-colors">Clear all</button>
            </div>

            <!-- Size Filter -->
            <div class="mb-5 pb-5 border-b border-gray-100">
                <button class="filter-toggle flex items-center justify-between w-full mb-3" data-target="size-filter">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Size</span>
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-400 transition-transform"></i>
                </button>
                <div id="size-filter" class="filter-content">
                    <div class="flex flex-wrap gap-2">
                        <% ['XS','S','M','L','XL','2X'].forEach(s => { %>
                        <button class="size-chip px-3 py-1.5 text-xs font-semibold text-gray-600 border border-gray-200 rounded-lg hover:border-gray-900 hover:text-gray-900 transition-all">
                            <%= s %>
                        </button>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- Availability Filter -->
            <div class="mb-5 pb-5 border-b border-gray-100">
                <button class="filter-toggle flex items-center justify-between w-full mb-3" data-target="avail-filter">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Availability</span>
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-400 transition-transform"></i>
                </button>
                <div id="avail-filter" class="filter-content">
                    <div class="space-y-2.5">
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="checkbox" class="rounded w-3.5 h-3.5 border-gray-300" checked>
                            <span class="text-sm text-gray-700 font-medium">In Stock</span>
                            <span class="ml-auto text-xs text-gray-400 font-semibold">(430)</span>
                        </label>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="checkbox" class="rounded w-3.5 h-3.5 border-gray-300">
                            <span class="text-sm text-gray-700 font-medium">Out Of Stock</span>
                            <span class="ml-auto text-xs text-gray-400 font-semibold">(15)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Category Filter -->
            <div class="mb-5 pb-5 border-b border-gray-100">
                <button class="filter-toggle flex items-center justify-between w-full mb-3" data-target="cat-filter">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Category</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-400"></i>
                </button>
                <div id="cat-filter" class="filter-content collapsed">
                    <div class="space-y-2">
                        <% ['T-Shirts','Hoodies','Pants','Jackets','Accessories'].forEach(cat => { %>
                        <label class="flex items-center space-x-2 cursor-pointer">
                            <input type="checkbox" class="rounded w-3.5 h-3.5 border-gray-300">
                            <span class="text-sm text-gray-700 font-medium"><%= cat %></span>
                        </label>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- Colors Filter -->
            <div class="mb-5 pb-5 border-b border-gray-100">
                <button class="filter-toggle flex items-center justify-between w-full mb-3" data-target="color-filter">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Colors</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-400"></i>
                </button>
                <div id="color-filter" class="filter-content collapsed">
                    <div class="flex flex-wrap gap-2 pt-1">
                        <% [
                            { label: 'Black',   hex: '#111827' },
                            { label: 'White',   hex: '#f9fafb' },
                            { label: 'Gray',    hex: '#9ca3af' },
                            { label: 'Beige',   hex: '#d4c5a9' },
                            { label: 'Navy',    hex: '#1e3a5f' },
                            { label: 'Olive',   hex: '#7c7a3a' },
                        ].forEach(c => { %>
                        <button class="color-swatch w-7 h-7 rounded-full border-2 border-white ring-1 ring-gray-200 hover:ring-gray-600 transition-all"
                                style="background-color:<%= c.hex %>;"
                                title="<%= c.label %>">
                        </button>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- Price Range Filter -->
            <div class="mb-5 pb-5 border-b border-gray-100">
                <button class="filter-toggle flex items-center justify-between w-full mb-3" data-target="price-filter">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Price Range</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-400"></i>
                </button>
                <div id="price-filter" class="filter-content collapsed">
                    <div class="space-y-3">
                        <input id="price-range" type="range" min="0" max="500" value="250"
                               class="w-full h-1.5 bg-gray-200 rounded-full appearance-none cursor-pointer accent-gray-900">
                        <div class="flex justify-between text-xs font-semibold text-gray-500">
                            <span>$0</span>
                            <span id="price-val">$250</span>
                            <span>$500</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Collections Filter -->
            <div class="mb-5 pb-5 border-b border-gray-100">
                <button class="filter-toggle flex items-center justify-between w-full">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Collections</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-400"></i>
                </button>
            </div>

            <!-- Tags Filter -->
            <div class="mb-5 pb-5 border-b border-gray-100">
                <button class="filter-toggle flex items-center justify-between w-full">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Tags</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-400"></i>
                </button>
            </div>

            <!-- Ratings Filter -->
            <div class="mb-2">
                <button class="filter-toggle flex items-center justify-between w-full">
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-wider">Ratings</span>
                    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-400"></i>
                </button>
            </div>
        </aside>

        <!-- ========================
             MAIN CONTENT AREA
        ========================= -->
        <main class="flex-1 min-w-0 overflow-y-auto pr-1">

            <!-- Breadcrumb -->
            <nav class="flex items-center space-x-1 text-xs text-gray-400 font-medium mb-3">
                <a href="/" class="hover:text-gray-700 transition-colors">Home</a>
                <i data-lucide="chevron-right" class="w-3 h-3"></i>
                <span class="text-gray-700 font-semibold">Products</span>
            </nav>

            <!-- Page Heading -->
            <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight mb-5">PRODUCTS</h1>

            <!-- Search + Category Tabs Row -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 mb-6">

                <!-- Search Bar -->
                <div class="flex items-center bg-white border border-gray-200 rounded-xl px-3 py-2.5 space-x-2 w-full sm:w-56 shadow-sm">
                    <i data-lucide="search" class="w-4 h-4 text-gray-400 flex-shrink-0"></i>
                    <input id="product-search" type="text" placeholder="Search"
                           class="text-sm text-gray-700 placeholder-gray-400 outline-none w-full bg-transparent">
                </div>

                <!-- Category Tabs -->
                <div class="flex items-center gap-2 overflow-x-auto pb-1 flex-1 scrollbar-hide">
                    <% ['New','Bags','Polos & T-Shirts','Shoes','Summer Shorts'].forEach((tab, i) => { %>
                    <button class="cat-tab flex-shrink-0 px-4 py-2 text-xs font-semibold rounded-full border border-gray-200 text-gray-600 hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-all <%= i === 0 ? 'active' : '' %>">
                        <%= tab %>
                    </button>
                    <% }) %>
                </div>

                <!-- Sort Dropdown -->
                <div class="flex items-center space-x-2 flex-shrink-0">
                    <label class="text-xs font-semibold text-gray-400 hidden xl:block">Sort by</label>
                    <div class="relative">
                        <select id="sort-select"
                                class="appearance-none bg-white border border-gray-200 rounded-xl text-xs font-semibold text-gray-700 pl-3 pr-8 py-2.5 outline-none cursor-pointer shadow-sm hover:border-gray-400 transition-colors">
                            <option value="newest">Newest</option>
                            <option value="price-asc">Price: Low → High</option>
                            <option value="price-desc">Price: High → Low</option>
                            <option value="discount">Most Discounted</option>
                        </select>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-400 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    </div>
                </div>
            </div>

            <!-- Results Info -->
            <div class="flex items-center justify-between mb-4">
                <p class="text-sm text-gray-400 font-medium">
                    Showing
                    <% if (typeof products !== 'undefined' && products.length > 0) { %>
                        <span class="text-gray-700 font-bold"><%= products.length %></span> products
                    <% } else { %>
                        <span class="text-gray-700 font-bold">0</span> products
                    <% } %>
                </p>

                <!-- View toggle (Grid / List) -->
                <div class="flex items-center space-x-1 bg-white border border-gray-200 rounded-xl p-1">
                    <button id="grid-view-btn" class="p-1.5 rounded-lg bg-gray-900 text-white transition-colors">
                        <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
                    </button>
                    <button id="list-view-btn" class="p-1.5 rounded-lg text-gray-400 hover:text-gray-700 transition-colors">
                        <i data-lucide="layout-list" class="w-3.5 h-3.5"></i>
                    </button>
                </div>
            </div>

            <!-- ========================
                 PRODUCT GRID
            ========================= -->
            <% if (typeof products !== 'undefined' && products.length > 0) { %>
            <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">

                <% products.forEach(product => { %>
                <div class="product-card group bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 cursor-pointer"
                     style="<%= product.bgcolor ? 'background-color:' + product.bgcolor + ';' : '' %>">

                    <!-- Product Image Area -->
                    <div class="relative overflow-hidden"
                         style="<%= product.panelcolor ? 'background-color:' + product.panelcolor + ';' : 'background-color:#f3f4f6;' %> min-height:220px;">

                        <% if (product.image) { %>
                        <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                             alt="<%= product.name %>"
                             class="w-full h-56 object-cover object-top transition-transform duration-300 group-hover:scale-105">
                        <% } else { %>
                        <!-- Placeholder when no image -->
                        <div class="w-full h-56 flex items-center justify-center">
                            <i data-lucide="image" class="w-16 h-16 text-gray-300"></i>
                        </div>
                        <% } %>

                        <!-- Discount Badge -->
                        <% if (product.discout && product.discout > 0) { %>
                        <span class="absolute top-3 left-3 bg-gray-900 text-white text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wide">
                            -<%= product.discout %>%
                        </span>
                        <% } %>

                        <!-- Wishlist icon (top right) -->
                        <button class="absolute top-3 right-3 p-2 bg-white/80 backdrop-blur-sm rounded-full text-gray-400 hover:text-red-500 transition-colors shadow-sm opacity-0 group-hover:opacity-100">
                            <i data-lucide="heart" class="w-3.5 h-3.5"></i>
                        </button>

                        <!-- Quick Add to Cart (slides up on hover) -->
                        <div class="add-to-cart-btn absolute bottom-0 left-0 right-0 p-3">
                            <form action="/cart/add" method="POST">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <button type="submit"
                                        class="w-full bg-gray-900 text-white text-xs font-bold py-2.5 rounded-xl hover:bg-gray-700 transition-colors shadow-lg">
                                    + Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Product Info -->
                    <div class="p-4" style="<%= product.bgcolor ? 'background-color:' + product.bgcolor + ';' : '' %>">
                        <p class="text-[10px] font-bold uppercase tracking-widest mb-1"
                           style="<%= product.textcolor ? 'color:' + product.textcolor + ';' : 'color:#9ca3af;' %>">
                            Cotton T-Shirt
                        </p>
                        <h3 class="text-sm font-bold truncate"
                            style="<%= product.textcolor ? 'color:' + product.textcolor + ';' : 'color:#111827;' %>">
                            <%= product.name %>
                        </h3>
                        <div class="flex items-center justify-between mt-2">
                            <div class="flex items-center space-x-1.5">
                                <% if (product.discout && product.discout > 0) { %>
                                <span class="text-sm font-extrabold"
                                      style="<%= product.textcolor ? 'color:' + product.textcolor + ';' : 'color:#111827;' %>">
                                    $<%= Math.round(product.price * (1 - product.discout / 100)) %>
                                </span>
                                <span class="text-xs font-medium text-gray-400 line-through">$<%= product.price %></span>
                                <% } else { %>
                                <span class="text-sm font-extrabold"
                                      style="<%= product.textcolor ? 'color:' + product.textcolor + ';' : 'color:#111827;' %>">
                                    $<%= product.price %>
                                </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>

            </div>

            <% } else { %>
            <!-- ========================
                 EMPTY STATE
            ========================= -->
            <div class="flex flex-col items-center justify-center py-24 text-center">
                <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mb-5">
                    <i data-lucide="package-open" class="w-10 h-10 text-gray-300"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-800 mb-1">No Products Found</h3>
                <p class="text-sm text-gray-400 max-w-xs">
                    Looks like we don't have any products listed yet. Check back soon or try a different filter.
                </p>
                <a href="/shop" class="mt-6 px-6 py-2.5 bg-gray-900 text-white text-sm font-semibold rounded-xl hover:bg-gray-700 transition-colors">
                    Reset Filters
                </a>
            </div>
            <% } %>

            <!-- Pagination -->
            <% if (typeof products !== 'undefined' && products.length > 0) { %>
            <div class="flex items-center justify-center space-x-2 mt-10">
                <button class="p-2 rounded-lg border border-gray-200 text-gray-400 hover:border-gray-900 hover:text-gray-900 transition-colors">
                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                </button>
                <% [1,2,3,4,5].forEach(n => { %>
                <button class="w-9 h-9 text-sm font-semibold rounded-lg border border-gray-200 text-gray-500 hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-all <%= n === 1 ? 'bg-gray-900 text-white border-gray-900' : '' %>">
                    <%= n %>
                </button>
                <% }) %>
                <button class="p-2 rounded-lg border border-gray-200 text-gray-600 hover:border-gray-900 hover:text-gray-900 transition-colors">
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>
            <% } %>

        </main>
    </div>

    <!-- ============================
         SCRIPTS
    ============================= -->
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // ---- Filter collapse toggles ----
        document.querySelectorAll('.filter-toggle[data-target]').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-target');
                const content = document.getElementById(targetId);
                if (!content) return;
                content.classList.toggle('collapsed');
                const icon = btn.querySelector('[data-lucide]');
                if (icon) {
                    const isOpen = !content.classList.contains('collapsed');
                    icon.setAttribute('data-lucide', isOpen ? 'chevron-down' : 'chevron-right');
                    lucide.createIcons();
                }
            });
        });

        // ---- Size chip toggle ----
        document.querySelectorAll('.size-chip').forEach(chip => {
            chip.addEventListener('click', () => chip.classList.toggle('active'));
        });

        // ---- Category tab toggle ----
        document.querySelectorAll('.cat-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
            });
        });

        // ---- Price range label ----
        const priceRange = document.getElementById('price-range');
        const priceVal   = document.getElementById('price-val');
        if (priceRange && priceVal) {
            priceRange.addEventListener('input', () => {
                priceVal.textContent = '$' + priceRange.value;
            });
        }

        // ---- View toggle (grid / list) ----
        const gridBtn  = document.getElementById('grid-view-btn');
        const listBtn  = document.getElementById('list-view-btn');
        const prodGrid = document.getElementById('product-grid');

        if (gridBtn && listBtn && prodGrid) {
            gridBtn.addEventListener('click', () => {
                prodGrid.className = prodGrid.className.replace(
                    /grid-cols-\d+|sm:grid-cols-\d+|md:grid-cols-\d+|xl:grid-cols-\d+/g, ''
                ).trim() + ' grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4';
                gridBtn.classList.add('bg-gray-900','text-white');
                gridBtn.classList.remove('text-gray-400');
                listBtn.classList.remove('bg-gray-900','text-white');
                listBtn.classList.add('text-gray-400');
            });

            listBtn.addEventListener('click', () => {
                prodGrid.className = prodGrid.className.replace(
                    /grid-cols-\d+|sm:grid-cols-\d+|md:grid-cols-\d+|xl:grid-cols-\d+/g, ''
                ).trim() + ' grid-cols-1';
                listBtn.classList.add('bg-gray-900','text-white');
                listBtn.classList.remove('text-gray-400');
                gridBtn.classList.remove('bg-gray-900','text-white');
                gridBtn.classList.add('text-gray-400');
            });
        }

        // ---- Search filter (client-side) ----
        function filterProducts() {
            const query = (document.getElementById('product-search').value || '').toLowerCase().trim();
            document.querySelectorAll('#product-grid .product-card').forEach(card => {
                const name = (card.querySelector('h3')?.textContent || '').toLowerCase();
                card.style.display = (!query || name.includes(query)) ? '' : 'none';
            });
        }
        const productSearch = document.getElementById('product-search');
        if (productSearch) productSearch.addEventListener('input', filterProducts);

        // ---- Mobile sidebar toggle ----
        const sidebarToggle  = document.getElementById('sidebar-toggle');
        const filterSidebar  = document.getElementById('filter-sidebar');
        if (sidebarToggle && filterSidebar) {
            sidebarToggle.addEventListener('click', () => {
                filterSidebar.classList.toggle('hidden');
                filterSidebar.classList.toggle('flex');
            });
        }

        // ---- Clear all filters ----
        const clearBtn = document.getElementById('clear-filters');
        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                document.querySelectorAll('.size-chip').forEach(c => c.classList.remove('active'));
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                if (priceRange) { priceRange.value = 250; priceVal.textContent = '$250'; }
                if (productSearch) { productSearch.value = ''; filterProducts(); }
            });
        }
    </script>
</body>
</html>
