<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - Scatch</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html, body {
            height: 100vh;
            overflow: hidden;
        }
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#e5e7eb] h-screen w-full flex items-center justify-center overflow-hidden p-4 md:p-8">

    <!-- Main Outer Container -->
    <div class="w-full max-w-6xl bg-white rounded-3xl shadow-xl overflow-hidden flex flex-col lg:flex-row max-h-[90vh]">
        
        <!-- LEFT SIDE: Shopping Cart (2/3 width on large screens) -->
        <div class="w-full lg:w-2/3 bg-white px-6 pt-6 pb-8 md:px-10 md:pt-10 md:pb-14 flex flex-col justify-between h-full overflow-hidden">
                <!-- Header -->
                <div class="flex justify-between items-end pb-8 border-b border-gray-100">
                    <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Shopping Cart</h1>
                    <span class="text-md font-semibold text-gray-500">3 Items</span>
                </div>

                <!-- Product Details Column Headers -->
                <div class="hidden md:grid grid-cols-12 gap-4 text-xs font-bold text-gray-400 uppercase tracking-wider mt-8 mb-4">
                    <div class="col-span-6">Product Details</div>
                    <div class="col-span-2 text-center">Quantity</div>
                    <div class="col-span-2 text-right">Price</div>
                    <div class="col-span-2 text-right">Total</div>
                </div>

                <!-- Cart Items Wrapper -->
                <div class="flex-1 overflow-y-auto pr-2 space-y-8 mt-6">
                    
                    <!-- Item 1: Fifa 19 -->
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center pb-8 border-b border-gray-100">
                        <!-- Product Details -->
                        <div class="col-span-6 flex items-center space-x-4">
                            <!-- Image Placeholder Box -->
                            <div class="w-20 h-20 bg-gray-100 rounded-xl flex items-center justify-center text-gray-400 border border-gray-200 flex-shrink-0">
                                <i data-lucide="image" class="w-8 h-8"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="font-bold text-gray-800 text-base">Fifa 19</span>
                                <span class="text-xs font-semibold text-red-500 uppercase mt-0.5">PS4</span>
                                <button class="text-xs text-gray-400 hover:text-red-500 font-medium mt-3 self-start transition-colors">Remove</button>
                            </div>
                        </div>
                        
                        <!-- Quantity Controls -->
                        <div class="col-span-2 flex items-center justify-start md:justify-center space-x-3">
                            <button class="text-gray-500 hover:text-gray-800 transition-colors">
                                <i data-lucide="minus" class="w-4 h-4"></i>
                            </button>
                            <input type="text" value="2" readonly 
                                   class="w-10 py-1 text-center font-semibold text-sm text-gray-800 border border-gray-200 rounded-md focus:outline-none">
                            <button class="text-gray-500 hover:text-gray-800 transition-colors">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                            </button>
                        </div>
                        
                        <!-- Price -->
                        <div class="col-span-2 text-left md:text-right">
                            <span class="font-bold text-gray-700 text-sm">£44.00</span>
                        </div>
                        
                        <!-- Total -->
                        <div class="col-span-2 text-left md:text-right">
                            <span class="font-bold text-gray-900 text-sm">£88.00</span>
                        </div>
                    </div>

                    <!-- Item 2: Glacier White 500GB -->
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center pb-8 border-b border-gray-100">
                        <!-- Product Details -->
                        <div class="col-span-6 flex items-center space-x-4">
                            <!-- Image Placeholder Box -->
                            <div class="w-20 h-20 bg-gray-100 rounded-xl flex items-center justify-center text-gray-400 border border-gray-200 flex-shrink-0">
                                <i data-lucide="image" class="w-8 h-8"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="font-bold text-gray-800 text-base">Glacier White 500GB</span>
                                <span class="text-xs font-semibold text-red-500 uppercase mt-0.5">PS4</span>
                                <button class="text-xs text-gray-400 hover:text-red-500 font-medium mt-3 self-start transition-colors">Remove</button>
                            </div>
                        </div>
                        
                        <!-- Quantity Controls -->
                        <div class="col-span-2 flex items-center justify-start md:justify-center space-x-3">
                            <button class="text-gray-500 hover:text-gray-800 transition-colors">
                                <i data-lucide="minus" class="w-4 h-4"></i>
                            </button>
                            <input type="text" value="1" readonly 
                                   class="w-10 py-1 text-center font-semibold text-sm text-gray-800 border border-gray-200 rounded-md focus:outline-none">
                            <button class="text-gray-500 hover:text-gray-800 transition-colors">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                            </button>
                        </div>
                        
                        <!-- Price -->
                        <div class="col-span-2 text-left md:text-right">
                            <span class="font-bold text-gray-700 text-sm">£249.99</span>
                        </div>
                        
                        <!-- Total -->
                        <div class="col-span-2 text-left md:text-right">
                            <span class="font-bold text-gray-900 text-sm">£249.99</span>
                        </div>
                    </div>

                    <!-- Item 3: Platinum Headset -->
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center pb-8 border-b border-gray-100">
                        <!-- Product Details -->
                        <div class="col-span-6 flex items-center space-x-4">
                            <!-- Image Placeholder Box -->
                            <div class="w-20 h-20 bg-gray-100 rounded-xl flex items-center justify-center text-gray-400 border border-gray-200 flex-shrink-0">
                                <i data-lucide="image" class="w-8 h-8"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="font-bold text-gray-800 text-base">Platinum Headset</span>
                                <span class="text-xs font-semibold text-red-500 uppercase mt-0.5">PS4</span>
                                <button class="text-xs text-gray-400 hover:text-red-500 font-medium mt-3 self-start transition-colors">Remove</button>
                            </div>
                        </div>
                        
                        <!-- Quantity Controls -->
                        <div class="col-span-2 flex items-center justify-start md:justify-center space-x-3">
                            <button class="text-gray-500 hover:text-gray-800 transition-colors">
                                <i data-lucide="minus" class="w-4 h-4"></i>
                            </button>
                            <input type="text" value="1" readonly 
                                   class="w-10 py-1 text-center font-semibold text-sm text-gray-800 border border-gray-200 rounded-md focus:outline-none">
                            <button class="text-gray-500 hover:text-gray-800 transition-colors">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                            </button>
                        </div>
                        
                        <!-- Price -->
                        <div class="col-span-2 text-left md:text-right">
                            <span class="font-bold text-gray-700 text-sm">£119.99</span>
                        </div>
                        
                        <!-- Total -->
                        <div class="col-span-2 text-left md:text-right">
                            <span class="font-bold text-gray-900 text-sm">£119.99</span>
                        </div>
                    </div>

                </div>

            <!-- Back Link -->
            <div class="mt-4 flex-shrink-0">
                <a href="/shop" class="inline-flex items-center space-x-2 text-sm font-bold text-indigo-600 hover:text-indigo-800 transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    <span>Continue Shopping</span>
                </a>
            </div>
        </div>

        <!-- RIGHT SIDE: Order Summary (1/3 width on large screens) -->
        <div class="w-full lg:w-1/3 bg-[#f3f4f6] p-6 md:p-10 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-gray-100 overflow-y-auto max-h-[90vh] lg:max-h-full">
            <div>
                <!-- Header -->
                <div class="pb-8 border-b border-gray-200">
                    <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 tracking-tight">Order Summary</h2>
                </div>

                <div class="mt-8 space-y-6">
                    <!-- Items Count & Cost -->
                    <div class="flex justify-between text-sm font-bold text-gray-700 uppercase tracking-wide">
                        <span>Items 3</span>
                        <span>£457.98</span>
                    </div>

                    <!-- Shipping Selector -->
                    <div class="flex flex-col space-y-2">
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Shipping</label>
                        <div class="relative">
                            <select class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-semibold text-gray-700 appearance-none outline-none focus:border-indigo-500 transition-all cursor-pointer">
                                <option>Standard Delivery - £5.00</option>
                                <option>Express Delivery - £10.00</option>
                            </select>
                            <i data-lucide="chevron-down" class="w-5 h-5 text-gray-400 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                        </div>
                    </div>

                    <!-- Promo Code -->
                    <div class="flex flex-col space-y-2">
                        <label class="text-xs font-bold text-gray-400 uppercase tracking-wider">Promo Code</label>
                        <input type="text" placeholder="Enter your code" 
                               class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-semibold text-gray-800 placeholder-gray-400 outline-none focus:border-[#f87171] transition-all">
                        <button type="button" class="w-24 py-2.5 bg-[#f87171] hover:bg-[#ef4444] text-white text-xs font-bold rounded-lg transition-all duration-200 shadow-sm self-start mt-2">
                            APPLY
                        </button>
                    </div>
                </div>
            </div>

            <!-- Footer Details & Checkout -->
            <div class="mt-12 pt-8 border-t border-gray-200 space-y-6">
                <!-- Total Cost -->
                <div class="flex justify-between text-md font-extrabold text-gray-900 uppercase">
                    <span>Total Cost</span>
                    <span>£462.98</span>
                </div>

                <!-- Checkout Button -->
                <button type="button" class="w-full py-4 bg-[#5850ec] hover:bg-[#4f46e5] active:scale-[0.99] text-white text-sm font-extrabold rounded-xl transition-all duration-200 shadow-lg tracking-wide uppercase">
                    Checkout
                </button>
            </div>
        </div>

    </div>

    <!-- Initialize Lucide Icons -->
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
