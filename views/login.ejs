<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch - Login & Sign Up</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html, body {
            height: 100vh;
            overflow: hidden;
        }
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="relative h-screen w-full flex items-center justify-center overflow-hidden bg-slate-900 select-none">

    <!-- Blurred background image exactly like the design (office setup with plants) -->
    <div class="absolute inset-0 w-full h-full bg-cover bg-center filter blur-[10px] scale-105" 
         style="background-image: url('https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1920&q=80');">
    </div>
    
    <!-- White tint overlay over the blurred background -->
    <div class="absolute inset-0 bg-white/20 backdrop-blur-[2px]"></div>

    <!-- Navigation Header -->
    <nav class="absolute top-0 left-0 right-0 flex justify-between items-center px-6 md:px-16 py-5 z-20">
        <div class="text-xl md:text-2xl font-bold text-gray-900 tracking-tight">Scatch</div>
        <div class="flex space-x-6 md:space-x-8 text-sm font-medium text-gray-600">
            <a href="#" class="hover:text-gray-900 transition-colors">Home</a>
            <a href="#" class="hover:text-gray-900 transition-colors">Features</a>
            <a href="#" class="hover:text-gray-900 transition-colors">Support</a>
        </div>
    </nav>

    <!-- Error/Success Flash Messages (Floating Alert at the top center) -->
    <% if (error && error.length > 0) { %>
        <div class="absolute top-20 left-1/2 -translate-x-1/2 z-50 w-full max-w-md px-4">
            <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded-xl shadow-lg flex items-center justify-between" role="alert">
                <div class="flex items-center space-x-2">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-red-500"></i>
                    <span class="text-sm font-medium"><%= error %></span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    <% } %>

    <!-- Main Card Container -->
    <main class="relative z-10 w-full max-w-5xl mx-4 bg-white/40 backdrop-blur-md rounded-[32px] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.18)] border border-white/30 overflow-hidden flex flex-col md:flex-row max-h-[90vh]">
        
        <!-- LEFT SIDE: Create Account (Sign Up) -->
        <section class="w-full md:w-1/2 bg-[#e8f3ff]/95 p-6 lg:p-10 flex flex-col justify-between rounded-t-[32px] md:rounded-t-none md:rounded-l-[32px] overflow-y-auto">
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 tracking-tight leading-tight">Create Account</h1>
                <p class="text-gray-500 text-sm mt-0.5 mb-6">Join our community today!</p>
                
                <form action="/users/register" method="POST" class="space-y-3.5">
                    <!-- Username -->
                    <div class="relative">
                        <i data-lucide="user" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="signup-username" name="name" placeholder="Username" 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#0082f6] focus:bg-[#f5f9ff] focus:ring-4 focus:ring-blue-100 text-gray-900 placeholder-gray-400 transition-all text-sm outline-none bg-white" 
                               required>
                    </div>

                    <!-- Email Address -->
                    <div class="relative">
                        <i data-lucide="mail" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="email" name="email" placeholder="Email Address" 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#0082f6] focus:bg-[#f5f9ff] focus:ring-4 focus:ring-blue-100 text-gray-900 placeholder-gray-400 transition-all text-sm outline-none bg-white" 
                               required>
                    </div>

                    <!-- Password -->
                    <div class="relative">
                        <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="password" name="password" placeholder="Password" 
                               class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-gray-300 focus:border-[#0082f6] focus:bg-[#f5f9ff] focus:ring-4 focus:ring-blue-100 text-gray-900 placeholder-gray-400 transition-all text-sm outline-none bg-white password-input" 
                               required>
                        <button type="button" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none toggle-password">
                            <i data-lucide="eye-off" class="w-4 h-4"></i>
                        </button>
                    </div>

                    <!-- Confirm Password -->
                    <div class="relative">
                        <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="password" name="confirmPassword" placeholder="Confirm Password" 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#0082f6] focus:bg-[#f5f9ff] focus:ring-4 focus:ring-blue-100 text-gray-900 placeholder-gray-400 transition-all text-sm outline-none bg-white" 
                               required>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" 
                            class="w-full py-2.5 bg-[#0082f6] hover:bg-[#0072d6] active:scale-[0.99] text-white font-medium rounded-xl transition-all duration-200 flex items-center justify-center space-x-1 shadow-sm mt-4">
                        <span>Sign Up</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"/>
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Footer Toggle link -->
            <div class="text-center text-sm text-gray-500 mt-6">
                Already have an account? 
                <button type="button" onclick="focusLogin()" class="text-[#0082f6] font-semibold hover:underline bg-transparent border-none cursor-pointer focus:outline-none">Log In</button>
            </div>
        </section>

        <!-- RIGHT SIDE: Welcome Back (Log In) -->
        <section class="w-full md:w-1/2 bg-white/95 p-6 lg:p-10 flex flex-col justify-between rounded-b-[32px] md:rounded-b-none md:rounded-r-[32px] overflow-y-auto">
            <div>
                <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 tracking-tight leading-tight">Welcome Back!</h1>
                <p class="text-gray-500 text-sm mt-0.5 mb-6">Sign in to continue to Scatch.</p>
                
                <form action="/users/login" method="POST" class="space-y-3.5">
                    <!-- Email Address -->
                    <div class="relative">
                        <i data-lucide="mail" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="email" id="login-email" name="email" placeholder="Email Address" 
                               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#0082f6] focus:bg-[#f5f9ff] focus:ring-4 focus:ring-blue-100 text-gray-900 placeholder-gray-400 transition-all text-sm outline-none bg-white" 
                               required>
                    </div>

                    <!-- Password -->
                    <div class="relative">
                        <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                        <input type="password" name="password" placeholder="Password" 
                               class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-gray-300 focus:border-[#0082f6] focus:bg-[#f5f9ff] focus:ring-4 focus:ring-blue-100 text-gray-900 placeholder-gray-400 transition-all text-sm outline-none bg-white password-input" 
                               required>
                        <button type="button" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none toggle-password">
                            <i data-lucide="eye-off" class="w-4 h-4"></i>
                        </button>
                    </div>

                    <!-- Forgot Password Link -->
                    <div class="text-right mt-0.5">
                        <a href="#" class="text-sm text-[#0082f6] font-semibold hover:underline">Forgot Password?</a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" 
                            class="w-full py-2.5 bg-[#0082f6] hover:bg-[#0072d6] active:scale-[0.99] text-white font-medium rounded-xl transition-all duration-200 flex items-center justify-center shadow-sm mt-4">
                        Log In
                    </button>
                </form>

                <!-- Divider: "or continue with" -->
                <div class="relative my-5">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-200"></div>
                    </div>
                    <div class="relative flex justify-center text-xs">
                        <span class="bg-white px-3 text-gray-400 font-medium tracking-wide">or continue with</span>
                    </div>
                </div>

                <!-- Social Buttons -->
                <div class="grid grid-cols-2 gap-4">
                    <!-- Google -->
                    <button type="button" 
                            class="flex items-center justify-center space-x-2 border border-gray-200 hover:bg-gray-50 active:scale-[0.98] text-gray-700 py-2 rounded-xl transition-all duration-200">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                        </svg>
                        <span class="text-sm font-semibold text-gray-700">Google</span>
                    </button>
                    <!-- GitHub -->
                    <button type="button" 
                            class="flex items-center justify-center space-x-2 border border-gray-200 hover:bg-gray-50 active:scale-[0.98] text-gray-700 py-2 rounded-xl transition-all duration-200">
                        <svg class="w-4 h-4 fill-current text-gray-900" viewBox="0 0 24 24">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                        </svg>
                        <span class="text-sm font-semibold text-gray-700">GitHub</span>
                    </button>
                </div>
            </div>

            <!-- Footer Toggle link -->
            <div class="text-center text-sm text-gray-500 mt-6">
                Don't have an account? 
                <button type="button" onclick="focusSignup()" class="text-[#0082f6] font-semibold hover:underline bg-transparent border-none cursor-pointer focus:outline-none">Sign Up</button>
            </div>
        </section>
        
    </main>

    <!-- Client-Side Scripts for Toggles and Focus Highlights -->
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Password Visibility Toggle
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function () {
                const input = this.parentElement.querySelector('.password-input');
                const icon = this.querySelector('i');
                
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.setAttribute('data-lucide', 'eye');
                } else {
                    input.type = 'password';
                    icon.setAttribute('data-lucide', 'eye-off');
                }
                lucide.createIcons(); // refresh icons inside button
            });
        });

        // Focus helpers for a dynamic feel
        function focusLogin() {
            const loginEmail = document.getElementById('login-email');
            if (loginEmail) {
                loginEmail.scrollIntoView({ behavior: 'smooth', block: 'center' });
                loginEmail.focus();
            }
        }

        function focusSignup() {
            const signupUsername = document.getElementById('signup-username');
            if (signupUsername) {
                signupUsername.scrollIntoView({ behavior: 'smooth', block: 'center' });
                signupUsername.focus();
            }
        }
    </script>
</body>
</html>
